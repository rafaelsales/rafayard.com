---
layout: layouts/base.njk
---
<header class="masthead">
  <h1>{{ site.author.name }}</h1>
  <p class="tagline">{{ site.tagline }}.</p>
  <p class="bio">{{ site.bioLines | join("<br>") | safe }}</p>
  <p class="subscribe"><a href="/feed.xml">Subscribe via RSS</a></p>
</header>
<main>
  {%- for post in collections.posts %}
  <a class="post-summary" href="{{ post.url }}">
    <article>
      <time datetime="{{ post.date | isoDateOnly }}">{{ post.date | readableDate }}</time>
      <h2>{{ post.data.title }}</h2>
      <p>{{ post.templateContent | excerpt }}</p>
      <span class="read-more">Read more →</span>
    </article>
  </a>
  {%- endfor %}
</main>
{%- set personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.author.name,
  "url": site.author.url,
  "jobTitle": site.author.jobTitle,
  "description": site.bioLines | join(" "),
  "sameAs": site.author.sameAs
} %}
{%- set websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.title,
  "url": site.url,
  "description": site.description,
  "author": { "@type": "Person", "name": site.author.name, "url": site.author.url }
} %}
<script type="application/ld+json">{{ personJsonLd | dump | safe }}</script>
<script type="application/ld+json">{{ websiteJsonLd | dump | safe }}</script>
